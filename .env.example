# Local development settings for docker-compose.yml
# Copy this file to .env before starting PostgreSQL.

POSTGRES_DB=workout_tracker
POSTGRES_USER=workout_tracker
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432

# Dedicated PostgreSQL instance for automated integration tests.
# Keep these values different from the development database settings.
POSTGRES_TEST_DB=workout_tracker_test
POSTGRES_TEST_USER=workout_tracker_test
POSTGRES_TEST_PASSWORD=local_test_only
POSTGRES_TEST_PORT=5433
